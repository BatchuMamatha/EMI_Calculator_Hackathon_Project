<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Each browser has its own runner class so they never write to the same
  report files simultaneously. TestRunner (Chrome) owns cucumber.html/json.
  EdgeTestRunner has no html/json plugins. Both share Allure and Extent
  (thread-safe). parallel="tests" keeps them running in parallel.
  Firefox is supported by BaseClass; uncomment the third <test> to enable it.
-->
<suite name="EMICalculatorHackathonSuite"
       parallel="tests"
       thread-count="4"
       data-provider-thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.hackathon.listeners.TestListener"/>
    </listeners>

    <test name="Chrome-Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.hackathon.runners.TestRunner"/>
        </classes>
    </test>

    <test name="Edge-Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.hackathon.runners.EdgeTestRunner"/>
        </classes>
    </test>

    <!--
    <test name="Firefox-Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.hackathon.runners.TestRunner"/>
        </classes>
    </test>
    -->

</suite>
