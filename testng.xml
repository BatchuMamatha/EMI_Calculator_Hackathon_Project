<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Sequential execution: Chrome runner finishes all 10 scenarios, then Edge
  runner starts. This is required because DriverFactory now uses a single
  static WebDriver (no ThreadLocal) per the project convention.
  Firefox kept commented per hackathon requirement (point p).
-->
<suite name="EMICalculatorHackathonSuite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.emicalc.automation.listeners.TestListener"/>
    </listeners>

    <test name="Chrome-Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.emicalc.automation.runners.ChromeRunner"/>
        </classes>
    </test>

    <test name="Edge-Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.emicalc.automation.runners.EdgeRunner"/>
        </classes>
    </test>

    <!--
    <test name="Firefox-Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.emicalc.automation.runners.FirefoxRunner"/>
        </classes>
    </test>
    -->

</suite>
