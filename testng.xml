<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Parallel execution across Chrome and Edge.
  Firefox kept commented per hackathon requirement (point p).

  parallel="tests"      -> each <test> block runs in its own thread, so the
                           Chrome runner and the Edge runner execute in
                           parallel. Each runner opens its browser ONCE
                           (BeforeClass), executes all 10 scenarios, then
                           closes it (AfterClass).
  thread-count=4        -> headroom for the two browsers + Cucumber's
                           data-provider thread
  data-provider-thread-count=1 -> scenarios within one runner run
                           sequentially in the same browser, as intended
-->
<suite name="EMICalculatorHackathonSuite"
       parallel="tests"
       thread-count="4"
       data-provider-thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.emicalc.automation.listeners.TestListener"/>
    </listeners>

    <test name="Chrome-Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.emicalc.automation.runners.ChromeRunner"/>
        </classes>
    </test>

    <test name="Edge-Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.emicalc.automation.runners.EdgeRunner"/>
        </classes>
    </test>

    <!--
    Firefox commented out as per hackathon requirement (point p):
    "Parallel test execution (Chrome, edge and comment the firefox code)"

    <test name="Firefox-Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.emicalc.automation.runners.FirefoxRunner"/>
        </classes>
    </test>
    -->

</suite>
