<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Single TestRunner is referenced in two <test> blocks, each parametrised
  with a different browser. parallel="tests" runs them in parallel threads.
  BaseClass uses ThreadLocal so the two browsers stay isolated.
  Firefox is supported by BaseClass; uncomment the third <test> to enable it.
-->
<suite name="EMICalculatorHackathonSuite"
       parallel="tests"
       thread-count="4"
       data-provider-thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.emicalc.automation.listeners.TestListener"/>
    </listeners>

    <test name="Chrome-Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.emicalc.automation.runners.TestRunner"/>
        </classes>
    </test>

    <test name="Edge-Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.emicalc.automation.runners.TestRunner"/>
        </classes>
    </test>

    <!--
    <test name="Firefox-Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.emicalc.automation.runners.TestRunner"/>
        </classes>
    </test>
    -->

</suite>
