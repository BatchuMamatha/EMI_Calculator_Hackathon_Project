<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="tests" runs each <test> block in its own thread, so Chrome and
  Edge runners execute simultaneously. Each runner opens its browser ONCE
  in @BeforeClass (DriverFactory.initDriver) and closes it in @AfterClass.
  DriverFactory uses ThreadLocal so the two threads don't share a driver.
  Firefox kept commented per hackathon requirement (point p).
-->
<suite name="EMICalculatorHackathonSuite"
       parallel="tests"
       thread-count="4"
       data-provider-thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.emicalc.automation.listeners.TestListener"/>
    </listeners>

    <test name="Chrome-Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.emicalc.automation.runners.ChromeRunner"/>
        </classes>
    </test>

    <test name="Edge-Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.emicalc.automation.runners.EdgeRunner"/>
        </classes>
    </test>

    <!--
    <test name="Firefox-Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.emicalc.automation.runners.FirefoxRunner"/>
        </classes>
    </test>
    -->

</suite>
