<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="tests" runs Chrome and Edge simultaneously.
  TestNG report output directory is set via <reportsDirectory> in pom.xml (surefire config).
  Firefox is supported by BaseClass; uncomment the third <test> to enable it.
-->
<suite name="EMICalculatorHackathonSuite"
       parallel="tests"
       thread-count="4"
       data-provider-thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.hackathon.listeners.TestListener"/>
        <!-- TestNG built-in reporters — write to output-dir above -->
        <listener class-name="org.testng.reporters.SuiteHTMLReporter"/>
        <listener class-name="org.testng.reporters.XMLReporter"/>
        <listener class-name="org.testng.reporters.JUnitReportReporter"/>
    </listeners>

    <test name="Chrome-Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.hackathon.runners.TestRunner"/>
        </classes>
    </test>

    <test name="Edge-Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.hackathon.runners.EdgeTestRunner"/>
        </classes>
    </test>

    <!--
    <test name="Firefox-Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.hackathon.runners.TestRunner"/>
        </classes>
    </test>
    -->

</suite>
