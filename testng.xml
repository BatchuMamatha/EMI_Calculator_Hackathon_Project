<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Single TestRunner class used for all browsers.
  Each <test> block passes its own cucumber.report.* system properties so
  Chrome and Edge write to separate report files and never conflict.
  TestNG report directory is set via <reportsDirectory> in pom.xml.
  Firefox is supported by BaseClass; uncomment the third <test> to enable it.
-->
<suite name="EMICalculatorHackathonSuite"
       parallel="tests"
       thread-count="4"
       data-provider-thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.hackathon.listeners.TestListener"/>
        <listener class-name="org.testng.reporters.SuiteHTMLReporter"/>
        <listener class-name="org.testng.reporters.XMLReporter"/>
        <listener class-name="org.testng.reporters.JUnitReportReporter"/>
    </listeners>

    <test name="Chrome-Tests">
        <parameter name="browser" value="chrome"/>
        <parameter name="cucumber.report.html" value="reports/cucumber/chrome-cucumber.html"/>
        <parameter name="cucumber.report.json" value="reports/cucumber/chrome-cucumber.json"/>
        <classes>
            <class name="com.hackathon.runners.TestRunner"/>
        </classes>
    </test>

    <test name="Edge-Tests">
        <parameter name="browser" value="edge"/>
        <parameter name="cucumber.report.html" value="reports/cucumber/edge-cucumber.html"/>
        <parameter name="cucumber.report.json" value="reports/cucumber/edge-cucumber.json"/>
        <classes>
            <class name="com.hackathon.runners.TestRunner"/>
        </classes>
    </test>

    <!--
    <test name="Firefox-Tests">
        <parameter name="browser" value="firefox"/>
        <parameter name="cucumber.report.html" value="reports/cucumber/firefox-cucumber.html"/>
        <parameter name="cucumber.report.json" value="reports/cucumber/firefox-cucumber.json"/>
        <classes>
            <class name="com.hackathon.runners.TestRunner"/>
        </classes>
    </test>
    -->

</suite>
