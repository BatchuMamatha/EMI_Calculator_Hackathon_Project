# --- Build output ---
target/
build/
out/
bin/

# --- IDE / Agent ---
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
.factorypath
.claude/

# --- Locally installed Allure CLI (generated via mvn allure:report, not committed) ---
.allure/

# --- OS ---
.DS_Store
Thumbs.db

# --- Reports / Logs / Screenshots (runtime-generated, not committed) ---
/logs/
/test-output/
/allure-results/
/allure-report/
/extent-report/
/ExtentReports/
/reports/
/screenshots/
/screenshots/**
*.log

# --- Test artefacts ---
*.lck
geckodriver.log
chromedriver.log
msedgedriver.log

# --- Local secrets ---
*.local.properties
src/test/resources/local/

# --- Generated Excel output ---
output/*.xlsx

# --- Excel temp lock files (created when a .xlsx is open in Excel) ---
~$*.xlsx
~$*.xls

# --- Cucumber literal placeholder files (safety net if system property substitution fails) ---
\#\{systemProperty*
